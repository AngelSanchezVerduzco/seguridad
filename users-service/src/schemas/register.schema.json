{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["email", "password", "confirmPassword", "usuario", "nombreCompleto", "direccion", "fechaNacimiento", "telefono"],
  "properties": {
    "email": {
      "type": "string",
      "format": "email"
    },
    "password": {
      "type": "string",
      "minLength": 10
    },
    "confirmPassword": {
      "type": "string",
      "minLength": 10
    },
    "usuario": {
      "type": "string",
      "minLength": 1
    },
    "nombreCompleto": {
      "type": "string",
      "minLength": 1
    },
    "direccion": {
      "type": "string",
      "minLength": 1
    },
    "fechaNacimiento": {
      "type": "string",
      "pattern": "^([0-2][0-9]|3[0-1])\\/(0[1-9]|1[0-2])\\/[0-9]{4}$"
    },
    "telefono": {
      "type": "string",
      "pattern": "^[0-9]{1,10}$"
    }
  },
  "additionalProperties": false
}
