{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway con Fastify para enrutar microservicios",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
