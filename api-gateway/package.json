  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/http-proxy": "^11.4.3",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
